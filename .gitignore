# ─── Data artefacts ────────────────────────────────────────────────────────
# Nothing derived from the Gaia catalogue is ever committed. Everything here is
# reproducible by running /pipeline; the repo carries the code, not the sky.

# Packed binary buffers + meta.json consumed by the renderer (stage 2 output).
/web/public/data/*
!/web/public/data/.gitkeep

# Pipeline intermediates and outputs (stage 1 output).
/pipeline/data/
/pipeline/out/
/pipeline/cache/
*.parquet
*.feather
*.vot
*.votable
*.fits
*.fits.gz
*.ecsv
*.npy
*.npz
*.bin
*.buf

# astroquery / astropy caches and download temp files
.astropy/
.astroquery/
**/astroquery_cache/
*.tap_job
*.async

# ─── Python (/pipeline) ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

